{
  "ConnectionStrings": {
    "Orchestrator": "Server=localhost,1433;Database=Orchestrator;User Id=sa;Password=__set_via_environment__;TrustServerCertificate=True;Encrypt=False"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "workflow-orchestrator" }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379"
  },
  "Engine": {
    "MaxStepsPerWorkflow": 50,
    "IdempotencyCacheTtl": "1.00:00:00",
    "MaxScheduleAhead": "365.00:00:00"
  },
  "Scheduler": {
    "Enabled": true,
    "PollInterval": "00:00:01",
    "BatchSize": 50
  },
  "Worker": {
    "Enabled": true,
    "PollInterval": "00:00:01",
    "MaxDegreeOfParallelism": 4,
    "LeaseDuration": "00:00:30",
    "HeartbeatInterval": "00:00:10",
    "ClaimBatchSize": 20,
    "RecoveryBatchSize": 50,
    "RunLockExpiry": "00:00:15",
    "RunLockWaitTimeout": "00:00:05"
  },
  "Handlers": {
    "Http": {
      "AllowedHosts": [],
      "MaxResponseChars": 65536
    }
  },
  "RateLimiting": {
    "RunCreation": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "ApiKeys": {
    "Keys": []
  },
  "Swagger": {
    "Enabled": false
  }
}
