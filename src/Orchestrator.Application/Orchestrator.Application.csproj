<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Orchestrator.Application</RootNamespace>
    <AssemblyName>Orchestrator.Application</AssemblyName>
    <!-- Request/response contracts live here; their XML docs feed Swagger. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orchestrator.Domain\Orchestrator.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Relational is required for ExecuteUpdateAsync (atomic step claims) in EF Core 8. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orchestrator.UnitTests" />
  </ItemGroup>

</Project>
