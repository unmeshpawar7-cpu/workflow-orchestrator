# Copy to .env and replace every value before running `docker compose up`.
# NOTE: .env is git-ignored. Never commit real secrets.

# SQL Server SA password (must satisfy SQL Server complexity rules: 8+ chars, upper, lower, digit, symbol)
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Passw0rd

# API keys are configured as SHA-256 hex digests, never as plaintext.
# Generate a digest with:  printf '%s' 'your-secret-key' | sha256sum
# The digests below correspond to the documented local-demo keys
#   dev-admin-key-change-me / dev-operator-key-change-me / dev-reader-key-change-me
# and MUST be replaced outside local development.
ADMIN_API_KEY_SHA256=29b401073038b82dd8106b36b0e4105cb0fcf084a083efccb6f525c8973bd2d2
OPERATOR_API_KEY_SHA256=10eb2df1ce0b95f9a08e4057f95f73b0d527a30ae87ce2622b6d3f9b68b6177c
READER_API_KEY_SHA256=3a1823d859d72b59fd1c0f068f4f9285637bc34f96d84697c2660936f28c951c

# Worker tuning (optional)
WORKER_MAX_DEGREE_OF_PARALLELISM=4
